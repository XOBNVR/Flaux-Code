# Ocean: an endless sea, drawn by one shader on the graphics card.
# Every pixel sends out a ray from the camera, walks along it until it
# touches a wave, then works out the water's colour there: the sky it
# reflects, the sun's glitter, the green light through thin crests, and
# the haze far away. (A homage to the famous ocean shaders on Shadertoy,
# written from scratch in Flaux.)
#
#   Drag the mouse (or the arrow keys): look around
#   W / S: sail faster / slower
#   1, 2, 3, 4: morning, midday, sunset, night
#   F11: fullscreen

shader ocean
    # ---- the ray for this pixel (x, y come from the top-left, like 2D)
    set sx to (x - width / 2) / height * 2
    set sy to (height / 2 - y) / height * 2
    set dx to sx
    set dy to sy - 0.12 + tilt
    set dz to 1.7
    set dl to sqrt(dx * dx + dy * dy + dz * dz)
    set dx to dx / dl
    set dy to dy / dl
    set dz to dz / dl
    # turn it left or right
    set tx to dx * cos(turn) + dz * sin(turn)
    set dz to dz * cos(turn) - dx * sin(turn)
    set dx to tx
    # where the camera is: 3.2 steps above the water, sailing forward
    set ox to sin(time * 0.15) * 2
    set oy to 3.6
    set oz to travel

    # ---- the sun (and the sky's colours) for this time of day
    set sunx to sin(turn_sun) * 0.9
    set suny to sun_up
    set sunz to cos(turn_sun) * 0.9
    set sl to sqrt(sunx * sunx + suny * suny + sunz * sunz)
    set sunx to sunx / sl
    set suny to suny / sl
    set sunz to sunz / sl
    # top of the sky, the horizon, and the sunlight, each as red, green, blue (0 to 1)
    set top_r to 0.10 + 0.15 * day
    set top_g to 0.18 + 0.32 * day
    set top_b to 0.35 + 0.55 * day
    set hor_r to 0.55 + 0.40 * warm + 0.20 * day
    set hor_g to 0.50 + 0.10 * warm + 0.33 * day
    set hor_b to 0.55 - 0.25 * warm + 0.42 * day
    set sun_r to 1.0
    set sun_g to 0.85 - 0.35 * warm
    set sun_b to 0.60 - 0.45 * warm + 0.25 * day
    if night > 0.5
        set top_r to 0.01
        set top_g to 0.02
        set top_b to 0.06
        set hor_r to 0.05
        set hor_g to 0.08
        set hor_b to 0.16
        set sun_r to 0.75
        set sun_g to 0.82
        set sun_b to 1.0
    end

    # ---- walk along the ray until it reaches the water
    set t to 0
    set hit to false
    set px to 0
    set py to 0
    set pz to 0
    set h to 0
    if dy < 0.02
        set t to 0.5
        repeat 90 times
            set px to ox + dx * t
            set py to oy + dy * t
            set pz to oz + dz * t
            # the waves' height here: four layers of sharp-topped waves, each smaller,
            # faster and turned compared with the one before
            set h to 0
            set fx to px * 0.26
            set fz to pz * 0.26
            set amp to 0.6
            set wt to time * 0.8
            repeat 4 times
                set a to sin(fx + sin(fz * 0.7 + wt) * 0.8 + wt)
                set b to sin(fz * 1.1 - fx * 0.4 - wt * 0.9)
                set w to 1 - abs(a * 0.7 + b * 0.3)
                add w * w * amp to h
                set nx to fx * 1.6 + fz * 1.2
                set fz to fz * 1.6 - fx * 1.2
                set fx to nx
                set amp to amp * 0.3
                set wt to wt * 1.3
            end
            set gap to py - h
            if gap < 0.002 * t
                set hit to true
                stop
            end
            add max(gap * 0.7, 0.01 * t) to t
            if t > 260
                stop
            end
        end
    end

    # ---- the sky (for the rays that don't touch the water)
    set up to max(dy, 0)
    set mixing to sqrt(up)
    set r to hor_r + (top_r - hor_r) * mixing
    set g to hor_g + (top_g - hor_g) * mixing
    set bl to hor_b + (top_b - hor_b) * mixing
    set facing to max(dx * sunx + dy * suny + dz * sunz, 0)
    set glow to facing ^ 8 * 0.35 + facing ^ 300 * 3
    if night > 0.5
        set glow to facing ^ 2000 * 4 + facing ^ 40 * 0.15     # a small, sharp moon
        # stars
        set star to sin(dx * 900) * sin(dy * 1300 + dz * 400) * sin(dz * 700 - dx * 300)
        if star > 0.996 and dy > 0.05
            add 0.8 to r
            add 0.8 to g
            add 0.9 to bl
        end
    end
    add sun_r * glow to r
    add sun_g * glow to g
    add sun_b * glow to bl
    # soft clouds
    if dy > 0.01
        set cx to dx / dy * 3 + time * 0.05
        set cz to dz / dy * 3
        set cloud to sin(cx * 0.9 + sin(cz * 0.7)) * sin(cz * 0.8 + sin(cx * 0.6)) + sin(cx * 2.1 - cz * 1.7) * 0.3
        set cloud to max(cloud - 0.35, 0) * min(dy * 4, 1) * (1 - night * 0.8)
        set r to r + (0.95 + 0.05 * warm - r) * cloud
        set g to g + (0.92 - 0.12 * warm - g) * cloud
        set bl to bl + (0.95 - 0.30 * warm - bl) * cloud
    end

    if hit
        # ---- the slope of the water here: its height a little to the side and a little ahead
        set e to 0.01 + t * 0.0015
        set hx to 0
        set fx to (px + e) * 0.26
        set fz to pz * 0.26
        set amp to 0.6
        set wt to time * 0.8
        repeat 7 times
            set a to sin(fx + sin(fz * 0.7 + wt) * 0.8 + wt)
            set b to sin(fz * 1.1 - fx * 0.4 - wt * 0.9)
            set w to 1 - abs(a * 0.7 + b * 0.3)
            add w * w * amp to hx
            set nx to fx * 1.6 + fz * 1.2
            set fz to fz * 1.6 - fx * 1.2
            set fx to nx
            set amp to amp * 0.3
            set wt to wt * 1.3
        end
        set hz to 0
        set fx to px * 0.26
        set fz to (pz + e) * 0.26
        set amp to 0.6
        set wt to time * 0.8
        repeat 7 times
            set a to sin(fx + sin(fz * 0.7 + wt) * 0.8 + wt)
            set b to sin(fz * 1.1 - fx * 0.4 - wt * 0.9)
            set w to 1 - abs(a * 0.7 + b * 0.3)
            add w * w * amp to hz
            set nx to fx * 1.6 + fz * 1.2
            set fz to fz * 1.6 - fx * 1.2
            set fx to nx
            set amp to amp * 0.3
            set wt to wt * 1.3
        end
        set h0 to 0
        set fx to px * 0.26
        set fz to pz * 0.26
        set amp to 0.6
        set wt to time * 0.8
        repeat 7 times
            set a to sin(fx + sin(fz * 0.7 + wt) * 0.8 + wt)
            set b to sin(fz * 1.1 - fx * 0.4 - wt * 0.9)
            set w to 1 - abs(a * 0.7 + b * 0.3)
            add w * w * amp to h0
            set nx to fx * 1.6 + fz * 1.2
            set fz to fz * 1.6 - fx * 1.2
            set fx to nx
            set amp to amp * 0.3
            set wt to wt * 1.3
        end
        set nx to h0 - hx
        set ny to e
        set nz to h0 - hz
        set nl to sqrt(nx * nx + ny * ny + nz * nz)
        set nx to nx / nl
        set ny to ny / nl
        set nz to nz / nl

        # ---- the reflected ray, and the sky it sees
        set dn to dx * nx + dy * ny + dz * nz
        set rx to dx - 2 * dn * nx
        set ry to abs(dy - 2 * dn * ny)
        set rz to dz - 2 * dn * nz
        set rm to sqrt(ry)
        set sky_r to hor_r + (top_r - hor_r) * rm
        set sky_g to hor_g + (top_g - hor_g) * rm
        set sky_b to hor_b + (top_b - hor_b) * rm
        set rf to max(rx * sunx + ry * suny + rz * sunz, 0)
        set glitter to rf ^ 120 * 6 + rf ^ 12 * 0.25
        if night > 0.5
            set glitter to rf ^ 400 * 3
        end

        # ---- how much the water reflects: more when you look along it (Fresnel)
        set look to max(0 - dn, 0)
        set fresnel to min(0.03 + 0.97 * (1 - look) ^ 5, 0.85)

        # ---- the water's own colour: deep blue, lit by the sun, greener in the thin crests
        set lit to max(nx * sunx + ny * suny + nz * sunz, 0)
        set light to 0.25 + 0.75 * day + 0.2 * warm
        if night > 0.5
            set light to 0.12
        end
        set deep_r to (0.01 + 0.06 * lit) * light
        set deep_g to (0.10 + 0.16 * lit) * light
        set deep_b to (0.20 + 0.16 * lit) * light
        set crest to max(h0 - 0.5, 0) * 0.5 * light
        add 0.10 * crest to deep_r
        add 0.55 * crest to deep_g
        add 0.45 * crest to deep_b

        set r to deep_r + (sky_r - deep_r) * fresnel + sun_r * glitter
        set g to deep_g + (sky_g - deep_g) * fresnel + sun_g * glitter
        set bl to deep_b + (sky_b - deep_b) * fresnel + sun_b * glitter

        # ---- white foam on the sharpest crests
        set foam to max(h0 - 0.68, 0) * 3 * max(ny - 0.6, 0) * light
        set r to r + foam
        set g to g + foam
        set bl to bl + foam

        # ---- far away the sea fades into the haze at the horizon
        set haze to 1 - 2.71828 ^ (0 - t * 0.0055)
        set r to r + (hor_r - r) * haze
        set g to g + (hor_g - g) * haze
        set bl to bl + (hor_b - bl) * haze
    end

    # a gentle finish: brighter middles, darker corners
    set r to r ^ 0.8
    set g to g ^ 0.8
    set bl to bl ^ 0.8
    set edge to 1 - 0.25 * ((x / width - 0.5) ^ 2 + (y / height - 0.5) ^ 2) * 2
    return rgb(min(255, r * 255 * edge), min(255, g * 255 * edge), min(255, bl * 255 * edge))
end

window(960, 540, "Ocean   (drag to look, W/S speed, 1-4 time of day, F11 fullscreen)")

set turn to 0.0
set tilt to 0.0
set travel to 0.0
set sail to 4.0
set mood to 3            # 1 morning, 2 midday, 3 sunset, 4 night
set turn_sun to 0.0
set sun_up to 0.12
set day to 0.0
set warm to 1.0
set night to 0.0
set last to seconds()

repeat forever
    set now to seconds()
    set dt to min(now - last, 0.1)
    set last to now

    # looking around: drag with the mouse, or the arrow keys
    if mouse_down()
        set turn to turn + mouse_moved_x() * 0.004
        set tilt to tilt - mouse_moved_y() * 0.002
    end
    if key_down("left")
        set turn to turn - dt
    end
    if key_down("right")
        set turn to turn + dt
    end
    if key_down("up")
        set tilt to tilt + dt * 0.4
    end
    if key_down("down")
        set tilt to tilt - dt * 0.4
    end
    set tilt to max(-0.35, min(0.45, tilt))

    # sailing
    if key_down("w")
        set sail to min(30, sail + dt * 8)
    end
    if key_down("s")
        set sail to max(0, sail - dt * 8)
    end
    set travel to travel + sail * dt

    # time of day
    repeat with k from 1 to 4
        if key_pressed(text(k))
            set mood to k
        end
    end
    set want_up to 0.12
    set want_day to 0.0
    set want_warm to 1.0
    set want_night to 0.0
    if mood = 1
        set want_up to 0.25
        set want_day to 0.35
        set want_warm to 0.55
    else if mood = 2
        set want_up to 0.9
        set want_day to 1.0
        set want_warm to 0.0
    else if mood = 4
        set want_up to 0.3
        set want_night to 1.0
        set want_warm to 0.0
    end
    # glide to the new time of day instead of jumping
    set ease to min(1, dt * 2)
    set sun_up to sun_up + (want_up - sun_up) * ease
    set day to day + (want_day - day) * ease
    set warm to warm + (want_warm - warm) * ease
    set night to night + (want_night - night) * ease * 2
    if mood = 4
        set night to 1.0
    else if night < 0.5
        set night to 0.0
    end

    clear()
    effect(ocean)
    show()
end
