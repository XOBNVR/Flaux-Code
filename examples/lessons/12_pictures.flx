# Lesson 12: pictures (sprites)
# ship.png is in the same folder as this program.
window(800, 600, "Pictures")

set x to 400

repeat forever
    if key_down("left")
        subtract 6 from x
    end
    if key_down("right")
        add 6 to x
    end

    clear("navy")
    image("ship.png", x - 32, 480, 64, 64)
    write("Arrow keys move the ship", 10, 10)
    show()
end
