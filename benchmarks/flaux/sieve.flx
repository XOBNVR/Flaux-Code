# Sieve of Eratosthenes: tests loops and list access.
set limit to 50_000_000
set is_prime to (limit + 1) copies of true
set is_prime[1] to false
set count to 0
repeat with i from 2 to limit
    if is_prime[i]
        add 1 to count
        repeat with j from i * i to limit by i
            set is_prime[j] to false
        end
    end
end
say count
