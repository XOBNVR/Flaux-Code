# a shader paints the floor in squares, from above
# frames: 1
# near: 10 10 #ffffff
# near: 30 10 #303030
# near: 110 90 #404040
# near: 90 90 #ffffff
shader squares
    if (floor(x) + floor(z)) mod 2 = 0
        return "white"
    end
    return "black"
end

window(200, 200)
sun(0, 1, 0)
camera(0.01, 10, 0, 0, 0, 0, 30)
plane(0, 0, 0, 20, 20, squares)
